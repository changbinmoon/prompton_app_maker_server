.env

# Python
# 주의: 이 프로젝트에는 소스 패키지 build/ 가 있으므로 build/ 를 무시하지 않는다.
#       (uv package = false 이므로 배포 산출물 디렉토리는 생성되지 않는다)
__pycache__/
*.py[cod]
*$py.class
*.so

# 가상환경
.venv/
venv/
env/

# 테스트 / 타입 체크 / 린트 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Worker 작업 디렉토리 (로컬 실행 시)
/data/
