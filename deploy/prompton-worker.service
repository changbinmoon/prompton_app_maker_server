[Unit]
Description=Prompton AI Worker
Documentation=https://github.com/prompton/prompton-ai-worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prompton
Group=prompton
WorkingDirectory=/opt/prompton-ai-worker
ExecStart=/opt/prompton-ai-worker/.venv/bin/python -m main
EnvironmentFile=/etc/prompton-worker/env

# 자동 재시작 (NFR Design Pattern 6: Process Supervisor)
Restart=on-failure
RestartSec=5

# Graceful Shutdown (NFR Design Pattern 7)
# SIGTERM 수신 시 진행 중인 Job을 완료한 뒤 종료한다.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=300

# 로그: stdout/stderr -> journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prompton-worker

# 보안 강화
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Status API, SQS, S3 및 로컬 도구 작업에 필요한 경로만 쓰기 허용
ReadWritePaths=/data/jobs /data/hermes /data/gradle

# Android SDK에 쓰기가 필요한 별도 배포에서만 승인 후 해당 경로를 추가한다.

[Install]
WantedBy=multi-user.target
