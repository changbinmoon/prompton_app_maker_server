# Prompton AI Worker 환경 변수 예시
#
# 배포 위치: /etc/prompton-worker/env
# 권한: chmod 640, chown root:prompton
#
# 주의 (NFR Design Pattern 9: Credential-Free Authentication):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 를 여기에 넣지 않는다.
#   인증은 EC2 IAM Instance Profile을 통해 자동으로 처리된다.

# --- 필수 ---
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/440052841756/prompton-app-build-jobs-dev
S3_BUCKET_NAME=prompton-app-builder-dev-changbin
PROMPTON_API_BASE_URL=https://xb2z5ls8k0.execute-api.us-east-1.amazonaws.com

# --- 선택적 Status API 인증 ---
# 실제 값은 저장소에 기록하지 않고 /etc/prompton-worker/env에 mode 0640 이하로 주입한다.
PROMPTON_STATUS_API_KEY=

# --- 선택 (기본값 사용 가능) ---
AWS_REGION=us-east-1

# 작업 디렉토리 루트 (전용 EBS 볼륨 마운트 경로)
WORK_DIR=/data/jobs

# Queue VisibilityTimeout 조회 실패 시 사용할 기본값 (초)
VISIBILITY_TIMEOUT=300

# 작업 디렉토리 보존 시간 (시간)
CLEANUP_HOURS=24

# 로그 레벨: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 외부 실행 파일 경로 (systemd PATH에 의존하지 않도록 절대 경로 권장)
HERMES_CLI_PATH=/opt/hermes/bin/hermes
KIRO_CLI_PATH=kiro-cli
GRADLE_PATH=gradle

# Hermes host-configured provider/model, session, credential 저장 위치
# 서비스 사용자 소유로 미리 생성하고 `hermes setup`을 해당 HERMES_HOME에서 완료한다.
HERMES_HOME=/data/hermes

# --- Android 빌드 도구 (EC2 사전 설치 경로에 맞게 조정) ---
ANDROID_HOME=/opt/android-sdk
ANDROID_SDK_ROOT=/opt/android-sdk
JAVA_HOME=/usr/lib/jvm/java-17-amazon-corretto
GRADLE_USER_HOME=/data/gradle
